# Compiled binaries, test executables and profiles. Keep these rules repository-wide
# because Go tools can emit artifacts next to any package.
*.exe
*.dll
*.so
*.dylib
*.test
*.a
*.o
# Go test binaries on Unix are named <pkg>.test, on Windows <pkg>.test.exe;
# both are covered above. Profiles and traces from -cpuprofile/-memprofile:
*.prof
*.pprof
*.trace
cpu.out
mem.out
block.out
mutex.out

# WebAssembly output and its loader shim (generated by the Go toolchain).
*.wasm
*.wasm.gz
wasm_exec.js

cmd/cmd

# macOS cruft
.DS_Store

# Coverage artifacts
coverage*.out
coverage*.html
coverage-func.txt
coverage.txt

# Local tooling
.actrc
.env
.gh-pages-worktree/
persist_test.dat.wal
tinyrag
/sqltools
main
cmd/desktop/build
cmd/studio/build
/cmd/query_files_wasm/.build-fingerprint
/cmd/query_files_wasm/.wasm-build.*/
data/osm_full
data/osm_full_tags
data/osm_sample
data/osm_sample2
niederbayern-251206.osm.pbf
osm_import
cover_*
/demo
/wikirag
cmd.zip
bin/
.gocache
cmd/formigo/formigo
formigo.db
formigo.db.wal
/.gomodcache
# Local benchmark captures and comparison reports are reproducible evidence,
# not repository documentation. Keep them available for local optimization work
# without accidentally adding them to commits.
/BENCHMARKS.md
/docs/benchmarks/
/cmd/tinyTiles/docs/benchmark-results-*.md
demo.mbtiles
/mbtilesdemo
/mbtilesregion
/odbc/odbc

# Apple / Swift build products
/bindings/apple/build/
/bindings/c/build/
/bindings/python/build/
/bindings/python/dist/
/bindings/python/*.egg-info/
/bindings/python/tinysql/libtinysql.*
/bindings/rust/target/
/bindings/rust/Cargo.lock
/bindings/swift/CTinySQL.xcframework/
/bindings/swift/.build/
/bindings/swift/.swiftpm/

# Python bytecode
__pycache__/
*.py[cod]
